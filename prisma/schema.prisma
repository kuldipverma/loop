generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  name        String
  email       String    @unique
  password    String
  role        String    @default("MEMBER")
  createdAt   DateTime  @default(now())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbacks   Feedback[]
}

model Workspace {
  id        String     @id @default(uuid())
  name      String
  slug      String     @unique
  createdAt DateTime   @default(now())

  users     User[]
  feedbacks Feedback[]
}

model Feedback {
  id            String    @id @default(uuid())
  title         String
  description   String
  channel       String    @default("Support Ticket")
  customerLabel String?
  status        String    @default("NEW") // NEW, REVIEWED, ACTIONED
  createdAt     DateTime  @default(now())
  
  // AI Analysis fields (Ye teen line new add hui hain)
  sentiment     String?
  theme         String?
  aiSummary     String?

  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}