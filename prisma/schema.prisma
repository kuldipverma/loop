datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String     @id @default(cuid())
  name        String?
  email       String     @unique
  password    String?
  role        String     @default("ADMIN")
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id])
  feedbacks   Feedback[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Workspace {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  users     User[]
  feedbacks Feedback[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Feedback {
  id            String    @id @default(cuid())
  title         String
  description   String?
  channel       String?
  sentiment     String?
  theme         String?
  status        String    @default("NEW")
  customerLabel String?
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  userId        String?
  user          User?     @relation(fields: [userId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}